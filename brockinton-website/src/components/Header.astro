---
import { business } from '../data/site';
import Logo from './Logo.astro';
import Icon from './Icon.astro';

const links = [
  { href: '#services', label: 'Services' },
  { href: '#why', label: 'Why Brockinton' },
  { href: '#reviews', label: 'Reviews' },
  { href: '#storm-shelters', label: 'Storm Shelters' },
];
---

<header class="site-header" data-header>
  <div class="container bar">
    <a href="#top" class="brand" aria-label={`${business.shortName}, back to top`}>
      <Logo />
    </a>
    <nav class="nav" aria-label="Primary">
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <div class="actions">
      <a class="phone" href={business.phoneHref} aria-label={`Call ${business.phone}`}>
        <Icon name="phone" />
        <span>{business.phone}</span>
      </a>
      <a class="btn estimate" href="#estimate">Free estimate</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-btn>
        <span class="sr-only">Menu</span>
        <span class="bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>
  <div class="mobile-menu" id="mobile-menu" hidden data-menu>
    <ul>
      {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      <li><a href="#estimate">Free estimate</a></li>
    </ul>
    <a class="btn" href={business.phoneHref}><Icon name="phone" /> Call {business.phone}</a>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]')!;
  const menu = document.querySelector<HTMLElement>('[data-menu]')!;
  const setOpen = (open: boolean) => {
    btn.setAttribute('aria-expanded', String(open));
    menu.hidden = !open;
    header.classList.toggle('is-open', open);
  };
  btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  menu.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu.hidden) {
      setOpen(false);
      btn.focus();
    }
  });
  const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    transition: background-color 0.3s var(--ease), border-color 0.3s var(--ease), backdrop-filter 0.3s;
    border-bottom: 1px solid transparent;
    background: linear-gradient(to bottom, rgba(18, 14, 11, 0.7), rgba(18, 14, 11, 0));
  }
  .site-header.is-scrolled,
  .site-header.is-open {
    background: rgba(18, 14, 11, 0.86);
    backdrop-filter: blur(12px) saturate(1.2);
    -webkit-backdrop-filter: blur(12px) saturate(1.2);
    border-color: var(--line);
  }
  .bar {
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .brand {
    text-decoration: none;
    flex: none;
  }
  .nav {
    margin-inline: auto;
  }
  .nav ul {
    display: flex;
    gap: 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav a,
  .phone {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--bone-100);
    padding-block: 0.4rem;
    background: linear-gradient(var(--yellow-400), var(--yellow-400)) no-repeat left bottom / 0 2px;
    transition: background-size 0.25s var(--ease), color 0.2s;
  }
  .nav a:hover {
    background-size: 100% 2px;
    color: var(--bone-50);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-left: auto;
  }
  .nav + .actions {
    margin-left: 0;
  }
  .phone {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--yellow-400);
    font-size: 1.2rem;
    letter-spacing: 0.04em;
  }
  .phone :global(svg) {
    width: 18px;
    height: 18px;
  }
  .estimate {
    min-height: 42px;
    padding: 0.45rem 1.1rem;
    font-size: 1.05rem;
  }
  .menu-btn {
    display: none;
    width: 46px;
    height: 46px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: transparent;
    color: var(--bone-50);
    cursor: pointer;
    position: relative;
  }
  .bars,
  .bars::before,
  .bars::after {
    position: absolute;
    left: 12px;
    right: 12px;
    height: 2px;
    background: currentColor;
    content: '';
    transition: transform 0.25s var(--ease), opacity 0.2s;
  }
  .bars {
    top: 50%;
    margin-top: -1px;
  }
  .bars::before {
    left: 0;
    right: 0;
    top: -7px;
  }
  .bars::after {
    left: 0;
    right: 0;
    top: 7px;
  }
  .is-open .bars {
    background: transparent;
  }
  .is-open .bars::before {
    transform: translateY(7px) rotate(45deg);
  }
  .is-open .bars::after {
    transform: translateY(-7px) rotate(-45deg);
  }
  .mobile-menu {
    border-top: 1px solid var(--line);
    padding: 1rem var(--gutter) 1.5rem;
  }
  .mobile-menu ul {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
  }
  .mobile-menu li a {
    display: block;
    padding: 0.8rem 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.6rem;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }
  .mobile-menu .btn {
    width: 100%;
  }

  @media (max-width: 1080px) {
    .nav {
      display: none;
    }
    .actions {
      margin-left: auto;
    }
  }
  @media (min-width: 1081px) {
    .mobile-menu {
      display: none;
    }
  }
  @media (max-width: 1080px) {
    .menu-btn {
      display: inline-block;
    }
  }
  @media (max-width: 640px) {
    .phone span,
    .estimate {
      display: none;
    }
    .phone {
      width: 46px;
      height: 46px;
      justify-content: center;
      border: 1px solid var(--line-strong);
      border-radius: var(--radius);
      padding: 0;
      background: none;
    }
    .actions {
      gap: 0.6rem;
    }
  }
</style>
