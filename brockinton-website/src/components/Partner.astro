---
import { partner, business } from '../data/site';
import Icon from './Icon.astro';
---
<section id="storm-shelters" class="section partner" aria-labelledby="partner-title">
  <div class="container">
    <div class="panel">
      <div class="stripe" aria-hidden="true"></div>
      <div class="copy">
        <p class="eyebrow">Partner</p>
        <h2 id="partner-title">Storm shelters through <span>{partner.name}</span></h2>
        <p>We offer storm shelters through our partner, {partner.name}. Call us to talk through your property and options.</p>
        <div class="ctas">
          <a class="btn" href={partner.url} target="_blank" rel="noopener">Visit Cozy Caverns <Icon name="arrow" /><span class="sr-only"> (opens in a new tab)</span></a>
          <a class="btn btn--ghost" href={business.phoneHref}><Icon name="phone" /> {business.phone}</a>
        </div>
      </div>
    </div>
  </div>
</section>
<style>
  .partner { background: var(--soil-900); padding-top: 0; }
  .panel { position: relative; overflow: hidden; display: grid; padding: clamp(32px, 5vw, 64px); border-radius: var(--radius-lg); background: radial-gradient(120% 140% at 100% 0%, #3a2616 0%, var(--soil-800) 55%); border: 1px solid var(--line); }
  .stripe { position: absolute; right: -60px; top: 0; bottom: 0; width: 220px; opacity: 0.12; background: repeating-linear-gradient(-45deg, var(--yellow-400) 0 22px, transparent 22px 44px); }
  .copy { position: relative; max-width: 720px; display: grid; gap: 1.1rem; }
  h2 { font-size: clamp(2.4rem, 5vw, 4rem); }
  h2 span { color: var(--yellow-400); }
  .copy > p:not(.eyebrow) { font-size: 1.15rem; color: var(--bone-100); }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 0.6rem; }
</style>
