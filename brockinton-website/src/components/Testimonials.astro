---
import { testimonials } from '../data/site';
import Icon from './Icon.astro';
---
<section id="reviews" class="section reviews" aria-labelledby="reviews-title">
  <div class="container">
    <header class="section-head">
      <p class="eyebrow">Reviews</p>
      <h2 id="reviews-title">What customers say</h2>
    </header>
    <ul class="list">
      {testimonials.map((t) => (
        <li>
          <figure>
            <div class="stars" aria-hidden="true">{[0, 1, 2, 3, 4].map(() => <Icon name="star" />)}</div>
            <blockquote><p>&ldquo;{t.quote}&rdquo;</p></blockquote>
            <figcaption>{t.name}</figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .reviews { background: var(--soil-900); }
  .list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  figure { margin: 0; height: 100%; display: flex; flex-direction: column; gap: 1.2rem; padding: 32px 30px; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--soil-850); }
  .stars { display: flex; gap: 4px; color: var(--yellow-400); }
  .stars :global(svg) { width: 20px; height: 20px; fill: currentColor; }
  blockquote { margin: 0; flex: 1; }
  blockquote p { font-size: 1.2rem; line-height: 1.55; color: var(--bone-50); }
  figcaption { font-family: var(--font-display); font-weight: 700; font-size: 1.2rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--yellow-400); }
  @media (max-width: 960px) { .list { grid-template-columns: 1fr; } }
</style>
