---
import { business, services, formspreeId } from '../data/site';
import Icon from './Icon.astro';
const action = formspreeId ? `https://formspree.io/f/${formspreeId}` : undefined;
---
<section id="estimate" class="section estimate grain" aria-labelledby="estimate-title" tabindex="-1">
  <div class="container layout">
    <div class="intro">
      <p class="eyebrow">Free estimate</p>
      <h2 id="estimate-title">Tell us about <span>your job</span></h2>
      <p>Send the details and we'll get back to you. Prefer to talk? Call now.</p>
      <a class="call" href={business.phoneHref}>
        <Icon name="phone" />
        <span><small>Call or text</small>{business.phone}</span>
      </a>
      <p class="area"><Icon name="pin" /> Based in {business.city}, AR. Serving {business.serviceArea}.</p>
    </div>

    <form class="form" method="POST" action={action} data-estimate-form novalidate>
      <div class="row two">
        <label>
          <span>Name</span>
          <input name="name" autocomplete="name" required />
        </label>
        <label>
          <span>Phone</span>
          <input name="phone" type="tel" autocomplete="tel" inputmode="tel" required />
        </label>
      </div>
      <label>
        <span>Service</span>
        <select name="service" required>
          <option value="">Choose a service</option>
          {services.map((s) => <option>{s.title}</option>)}
          <option>Storm Shelters (Cozy Caverns)</option>
          <option>Something else</option>
        </select>
      </label>
      <label>
        <span>Property location</span>
        <input name="location" autocomplete="address-level2" placeholder="Town, road or address" required />
      </label>
      <label>
        <span>Job details</span>
        <textarea name="details" rows="5" placeholder="Acreage, what needs doing, access, timing..."></textarea>
      </label>
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
      <input type="hidden" name="_subject" value="New estimate request from the website" />
      <button class="btn submit" type="submit">Send request <Icon name="arrow" /></button>
      <p class="status" role="status" aria-live="polite" data-status></p>
    </form>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-estimate-form]')!;
  const status = form.querySelector<HTMLElement>('[data-status]')!;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    status.className = 'status';
    const invalid = [...form.querySelectorAll<HTMLInputElement>('[required]')].filter((el) => !el.value.trim());
    form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
    if (invalid.length) {
      invalid.forEach((el) => el.setAttribute('aria-invalid', 'true'));
      invalid[0].focus();
      status.textContent = 'Please fill in your name, phone, service and property location.';
      status.classList.add('err');
      return;
    }
    if (!form.action || !form.action.includes('formspree')) {
      status.textContent = 'Online requests are not connected yet. Please call 501-992-8818.';
      status.classList.add('err');
      return;
    }
    const btn = form.querySelector<HTMLButtonElement>('.submit')!;
    btn.disabled = true;
    status.textContent = 'Sending...';
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      status.textContent = "Thanks! Your request is in. We'll be in touch soon.";
      status.classList.add('ok');
    } catch {
      status.textContent = 'Something went wrong sending the form. Please call 501-992-8818.';
      status.classList.add('err');
    } finally {
      btn.disabled = false;
    }
  });
</script>

<style>
  .estimate { background: radial-gradient(100% 120% at 0% 0%, #2c1d12 0%, var(--soil-850) 50%, var(--soil-900) 100%); overflow: hidden; outline: none; }
  .layout { position: relative; z-index: 1; display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(40px, 6vw, 96px); align-items: start; }
  h2 { font-size: clamp(2.8rem, 6vw, 4.8rem); margin: 1rem 0 1.2rem; }
  h2 span { color: var(--yellow-400); display: block; }
  .intro > p:not(.eyebrow) { font-size: 1.15rem; color: var(--bone-300); }
  .call { display: inline-flex; align-items: center; gap: 16px; margin: 2rem 0 1.4rem; text-decoration: none; }
  .call :global(svg) { width: 54px; height: 54px; padding: 14px; border-radius: 50%; background: var(--yellow-400); color: #1a1206; }
  .call span { display: grid; font-family: var(--font-display); font-weight: 800; font-size: clamp(2rem, 4vw, 2.8rem); line-height: 1; color: var(--bone-50); letter-spacing: 0.02em; }
  .call small { font-weight: 600; font-size: 0.9rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--yellow-400); margin-bottom: 6px; }
  .area { display: flex; align-items: center; gap: 8px; }
  .area :global(svg) { width: 20px; height: 20px; color: var(--yellow-400); }
  .form { display: grid; gap: 18px; padding: clamp(24px, 3.5vw, 44px); border: 1px solid var(--line); border-radius: var(--radius-lg); background: rgba(18, 14, 11, 0.7); }
  .row.two { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  label { display: grid; gap: 8px; }
  label span { font-family: var(--font-display); font-weight: 700; font-size: 1rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--bone-100); }
  input, select, textarea {
    width: 100%; min-height: 50px; padding: 12px 14px; font: inherit; font-size: 1.05rem; color: var(--bone-50);
    background: var(--soil-900); border: 1px solid var(--line-strong); border-radius: var(--radius);
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  select { appearance: none; background-image: linear-gradient(45deg, transparent 50%, var(--bone-300) 50%), linear-gradient(135deg, var(--bone-300) 50%, transparent 50%); background-position: calc(100% - 22px) 50%, calc(100% - 16px) 50%; background-size: 6px 6px; background-repeat: no-repeat; padding-right: 44px; }
  textarea { resize: vertical; min-height: 130px; }
  input::placeholder, textarea::placeholder { color: var(--bone-400); }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--yellow-400); box-shadow: 0 0 0 3px rgba(244, 184, 31, 0.25); }
  [aria-invalid='true'] { border-color: #e0714a; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .submit { justify-self: start; min-width: 220px; }
  .submit:disabled { opacity: 0.6; cursor: progress; }
  .status { min-height: 1.5em; font-weight: 500; }
  .status.ok { color: #9fd49a; }
  .status.err { color: #f0a080; }
  @media (max-width: 900px) { .layout { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .row.two { grid-template-columns: 1fr; } .submit { width: 100%; } }
</style>
