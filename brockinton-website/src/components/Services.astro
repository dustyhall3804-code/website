---
import { services } from '../data/site';
import Icon from './Icon.astro';
---
<section id="services" class="section services" aria-labelledby="services-title">
  <div class="container">
    <header class="section-head">
      <p class="eyebrow">What we do</p>
      <h2 id="services-title">Services</h2>
      <p>Everything from clearing a homesite to digging a pond, across Central Arkansas.</p>
    </header>
    <ul class="grid">
      {services.map((s, i) => (
        <li class:list={['tile', { feature: s.id === 'pond-construction' }]}>
          <span class="icon"><Icon name={s.id} /></span>
          <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3>{s.title}</h3>
          {s.text && <p>{s.text}</p>}
        </li>
      ))}
    </ul>
    <div class="cta-row">
      <a class="btn" href="#estimate">Request a free estimate <Icon name="arrow" /></a>
    </div>
  </div>
</section>
<style>
  .services { background: var(--soil-900); }
  .grid {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: 1px; background: var(--line);
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--line); border-radius: var(--radius-lg); overflow: hidden;
  }
  .tile {
    position: relative; display: grid; align-content: start; gap: 0.7rem;
    min-height: 250px; padding: 30px 26px 28px;
    background: var(--soil-850);
    transition: background-color 0.3s var(--ease);
  }
  .tile:hover { background: var(--soil-800); }
  .tile::before {
    content: ''; position: absolute; left: 0; top: 0; height: 3px; width: 0;
    background: var(--yellow-400); transition: width 0.4s var(--ease);
  }
  .tile:hover::before { width: 100%; }
  .icon { color: var(--yellow-400); }
  .icon :global(svg) { width: 38px; height: 38px; }
  .num { position: absolute; top: 26px; right: 24px; font-family: var(--font-display); font-weight: 700; color: var(--bone-400); letter-spacing: 0.1em; }
  h3 { font-size: 1.9rem; margin-top: 0.6rem; }
  .tile p { color: var(--bone-300); }
  .feature { background: linear-gradient(160deg, #2a1c12, var(--soil-850) 70%); }
  .cta-row { margin-top: 40px; display: flex; justify-content: center; }
  @media (max-width: 1100px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .grid { grid-template-columns: 1fr; } .tile { min-height: 0; } }
</style>
