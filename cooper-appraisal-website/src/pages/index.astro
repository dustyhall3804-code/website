---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';
import PlaceholderImage from '../components/PlaceholderImage.astro';
import {
  Building2,
  Home as HomeIcon,
  Ruler,
  MapPin,
  ShieldCheck,
  Clock,
  FileCheck,
  ArrowRight,
  Quote,
  Phone,
  Mail,
} from '@lucide/astro';
import { SITE } from '../data/site';

const services = [
  {
    icon: Building2,
    title: 'Commercial Appraisals',
    body: 'Financing, litigation, and partnership decisions demand a valuation that holds up under scrutiny. We appraise retail, office, industrial, and multi-family properties across central Arkansas.',
    href: '/commercial',
  },
  {
    icon: HomeIcon,
    title: 'Residential Appraisals',
    body: "From pre-listing strategy to estate settlements and tax appeals, we deliver clear, well-supported valuations homeowners and professionals can rely on.",
    href: '/residential',
  },
  {
    icon: Ruler,
    title: 'House Measuring',
    body: 'ANSI-standard square footage measurement gives agents, sellers, and owners an accurate gross living area (GLA) — no guesswork, no disputes.',
    href: '/house-measuring',
  },
];

const differentiators = [
  {
    icon: MapPin,
    title: 'Local Knowledge, Local Accuracy',
    body: "We live and work in central Arkansas. That means real familiarity with neighborhoods, market trends, and property values other appraisers simply don't have.",
  },
  {
    icon: ShieldCheck,
    title: 'Licensed & Credentialed',
    body: 'Every report is prepared by a state-licensed appraiser and meets USPAP standards, so it holds up with lenders, courts, and taxing authorities.',
  },
  {
    icon: Clock,
    title: 'Fast, Reliable Turnaround',
    body: `We understand your deadlines. Most reports are delivered within ${SITE.turnaroundTime} of the site visit.`,
  },
  {
    icon: FileCheck,
    title: 'Precise, Defensible Reports',
    body: 'Every measurement and valuation is documented and supportable — built to withstand review, not just satisfy a checkbox.',
  },
];

const steps = [
  {
    number: '01',
    title: 'Reach Out',
    body: 'Call, email, or submit a request describing your property and the appraisal you need.',
  },
  {
    number: '02',
    title: 'Schedule the Visit',
    body: `We schedule a site visit at a time that works for you, typically within ${SITE.schedulingWindow}.`,
  },
  {
    number: '03',
    title: 'Inspection & Measurement',
    body: 'We inspect the property, take ANSI-standard measurements, and gather the details that support an accurate valuation.',
  },
  {
    number: '04',
    title: 'Receive Your Report',
    body: 'You receive a clear, well-documented appraisal report — ready for your lender, attorney, agent, or tax authority.',
  },
];

const testimonials = [1, 2, 3];
---

<Layout
  title="Cooper Appraisal Company | Residential & Commercial Appraisals in Greenbrier, AR"
  description="Certified residential and commercial real estate appraisals and ANSI-standard house measuring services serving Greenbrier and Central Arkansas."
  path="/"
>
  <!-- Hero -->
  <div class="relative isolate flex min-h-[92vh] items-center overflow-hidden bg-navy-950 text-cream-50">
    <PlaceholderImage label="Exterior of a central Arkansas home at dusk" tone="navy" variant="full" class="z-0" />
    <div class="relative z-10 mx-auto w-full max-w-7xl px-6 pt-28 pb-20 md:px-8 md:pt-32">
      <div class="max-w-2xl" data-reveal>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brass-400">
          Certified Appraisals &middot; Greenbrier &amp; Central Arkansas
        </p>
        <h1 class="mt-6 font-serif text-4xl leading-[1.1] tracking-tight sm:text-5xl md:text-6xl">
          Accurate Property Valuations You Can Stand Behind
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-cream-50/80">
          Cooper Appraisal Company delivers precise, defensible residential and commercial appraisals for homeowners,
          agents, lenders, and attorneys across central Arkansas.
        </p>
        <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:items-center">
          <Button href="/contact" variant="accent" size="lg">
            Request an Appraisal
            <ArrowRight class="h-4 w-4" aria-hidden="true" />
          </Button>
          <Button href="#services" variant="outlineLight" size="lg">Explore Our Services</Button>
        </div>
        <p class="mt-8 text-sm text-cream-50/60">
          Licensed in Arkansas &middot; {SITE.yearsInBusiness}+ Years of Experience &middot; Serving Faulkner County &amp;
          Beyond
        </p>
      </div>
    </div>
  </div>

  <!-- Services overview -->
  <Section id="services" tone="cream">
    <div class="max-w-2xl" data-reveal>
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brass-600">What We Do</p>
      <h2 class="mt-4 font-serif text-3xl leading-tight tracking-tight text-navy-950 sm:text-4xl">
        Appraisal Services Built Around Your Situation
      </h2>
      <p class="mt-4 text-navy-700/90">
        Whatever brought you here, we tailor the appraisal to the decision you're making.
      </p>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-3">
      {
        services.map((service, i) => (
          <div data-reveal data-reveal-delay={String(Math.min(i + 1, 3))}>
            <Card title={service.title} class="h-full">
              <service.icon slot="icon" class="h-8 w-8 text-brass-500" aria-hidden="true" />
              <p>{service.body}</p>
              <a
                slot="footer"
                href={service.href}
                class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-navy-900 transition-colors group-hover:text-brass-600"
              >
                Learn more <span class="sr-only">about {service.title}</span>
                <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-1" aria-hidden="true" />
              </a>
            </Card>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- Why choose us -->
  <Section tone="creamAlt">
    <div class="max-w-2xl" data-reveal>
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brass-600">Why Cooper Appraisal</p>
      <h2 class="mt-4 font-serif text-3xl leading-tight tracking-tight text-navy-950 sm:text-4xl">
        The Difference Shows Up in the Report
      </h2>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-x-8 gap-y-12 sm:grid-cols-2">
      {
        differentiators.map((item, i) => (
          <div class="flex gap-5" data-reveal data-reveal-delay={String(Math.min(i + 1, 4))}>
            <div class="flex h-12 w-12 shrink-0 items-center justify-center border border-brass-400/40 bg-white">
              <item.icon class="h-5 w-5 text-brass-500" aria-hidden="true" />
            </div>
            <div>
              <h3 class="font-serif text-lg text-navy-950">{item.title}</h3>
              <p class="mt-2 leading-relaxed text-navy-700/90">{item.body}</p>
            </div>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- How it works -->
  <Section tone="cream">
    <div class="max-w-2xl" data-reveal>
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brass-600">How It Works</p>
      <h2 class="mt-4 font-serif text-3xl leading-tight tracking-tight text-navy-950 sm:text-4xl">
        A Straightforward Process, Start to Finish
      </h2>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((step, i) => (
          <div
            class="relative border-t-2 border-brass-400 pt-6"
            data-reveal
            data-reveal-delay={String(Math.min(i + 1, 4))}
          >
            <span class="font-serif text-3xl text-brass-400/70">{step.number}</span>
            <h3 class="mt-3 font-serif text-lg text-navy-950">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-navy-700/90">{step.body}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- Coverage area -->
  <Section tone="navy">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
      <div data-reveal>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brass-400">Coverage Area</p>
        <h2 class="mt-4 font-serif text-3xl leading-tight tracking-tight sm:text-4xl">
          Proudly Serving Central Arkansas
        </h2>
        <p class="mt-5 max-w-lg leading-relaxed text-cream-50/80">
          Based in Greenbrier, we appraise residential and commercial properties throughout Faulkner County and the
          surrounding region. Outside this list? Reach out — we're happy to discuss your property.
        </p>
        <ul class="mt-8 flex flex-wrap gap-2">
          {
            SITE.serviceCities.map((city) => (
              <li class="border border-cream-50/20 px-3 py-1.5 text-sm text-cream-50/80">{city}</li>
            ))
          }
        </ul>
      </div>
      <div class="relative aspect-[4/3] border border-cream-50/10" data-reveal data-reveal-delay="1">
        <PlaceholderImage label="Service-area map of Faulkner County and Central Arkansas" tone="navy" class="h-full w-full" />
      </div>
    </div>
  </Section>

  <!-- Testimonials -->
  <Section tone="cream">
    <div class="max-w-2xl" data-reveal>
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brass-600">Client Feedback</p>
      <h2 class="mt-4 font-serif text-3xl leading-tight tracking-tight text-navy-950 sm:text-4xl">
        What Our Clients Say
      </h2>
      <p class="mt-4 text-navy-700/90">Real testimonials are coming soon — these slots are placeholders.</p>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-3">
      {
        testimonials.map((n) => (
          <div
            class="flex h-full flex-col border border-navy-900/10 bg-white p-8"
            data-reveal
            data-reveal-delay={String(Math.min(n, 3))}
          >
            <Quote class="h-7 w-7 text-brass-300" aria-hidden="true" />
            <p class="mt-4 flex-1 leading-relaxed text-navy-700/90 italic">
              "{'{{TESTIMONIAL_QUOTE}}'}"
            </p>
            <div class="mt-6 border-t border-navy-900/10 pt-4">
              <p class="text-sm font-semibold text-navy-950">{'{{CLIENT_NAME}}'}</p>
              <p class="text-xs uppercase tracking-wider text-navy-700/60">{'{{CLIENT_ROLE}}'}</p>
            </div>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- Contact CTA -->
  <Section tone="navy" padding="default">
    <div class="flex flex-col items-start gap-10 lg:flex-row lg:items-center lg:justify-between" data-reveal>
      <div class="max-w-xl">
        <h2 class="font-serif text-3xl leading-tight tracking-tight sm:text-4xl">Let's Talk About Your Appraisal</h2>
        <p class="mt-4 leading-relaxed text-cream-50/80">
          Whether you need a residential appraisal, a commercial valuation, or an accurate square footage measurement,
          Cooper Appraisal Company is ready to help.
        </p>
      </div>
      <div class="flex flex-col gap-4 sm:min-w-[16rem]">
        <a href={SITE.phoneHref} class="flex items-center gap-3 text-lg font-medium transition-colors hover:text-brass-400">
          <Phone class="h-5 w-5 text-brass-400" aria-hidden="true" />
          {SITE.phone}
        </a>
        <a href={SITE.emailHref} class="flex items-center gap-3 text-lg font-medium transition-colors hover:text-brass-400">
          <Mail class="h-5 w-5 text-brass-400" aria-hidden="true" />
          {SITE.email}
        </a>
        <Button href="/contact" variant="accent" size="lg" class="mt-2">
          Request an Appraisal
          <ArrowRight class="h-4 w-4" aria-hidden="true" />
        </Button>
      </div>
    </div>
  </Section>
</Layout>
