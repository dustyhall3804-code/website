---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import ContactForm from '../components/ContactForm.astro';
import { Phone, Mail, MapPin, Clock, LogIn } from '@lucide/astro';
import { SITE } from '../data/site';

const mapQuery = encodeURIComponent(`${SITE.addressLine1}, ${SITE.addressCity}, ${SITE.addressState} ${SITE.addressZip}`);
const mapSrc = `https://www.google.com/maps?q=${mapQuery}&output=embed`;
---

<Layout
  title="Contact & Request an Appraisal | Cooper Appraisal Company"
  description="Request a residential or commercial appraisal, get a fee quote, or ask a question. Serving Greenbrier and Central Arkansas."
  path="/contact"
>
  <PageHeader
    eyebrow="Contact"
    title="Request an Appraisal"
    description="Tell us about your property and we'll follow up promptly."
    imageLabel="Front door and entryway of a central Arkansas home"
  />

  <Section tone="cream">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-[1.4fr_1fr]">
      <div class="border border-navy-900/10 bg-white p-6 sm:p-10" data-reveal>
        <ContactForm />
      </div>

      <div class="lg:pt-2" data-reveal data-reveal-delay="1">
        <div class="border border-navy-900/10 bg-white p-8">
          <h2 class="font-serif text-xl text-navy-950">Get In Touch</h2>
          <ul class="mt-6 space-y-5 text-sm text-navy-700/90">
            <li class="flex items-start gap-3">
              <Phone class="mt-0.5 h-4 w-4 shrink-0 text-brass-500" aria-hidden="true" />
              <span class="flex flex-col">
                <a href={SITE.officePhoneHref} class="inline-block py-1 hover:text-brass-600">Office: {SITE.officePhone}</a>
                <a href={SITE.cellPhoneHref} class="inline-block py-1 hover:text-brass-600">Cell: {SITE.cellPhone}</a>
              </span>
            </li>
            <li class="flex items-start gap-3">
              <Mail class="mt-0.5 h-4 w-4 shrink-0 text-brass-500" aria-hidden="true" />
              <a href={SITE.emailHref} class="hover:text-brass-600">{SITE.email}</a>
            </li>
            <li class="flex items-start gap-3">
              <MapPin class="mt-0.5 h-4 w-4 shrink-0 text-brass-500" aria-hidden="true" />
              <span>{SITE.addressLine1}, {SITE.addressCity}, {SITE.addressState} {SITE.addressZip}</span>
            </li>
            <li class="flex items-start gap-3">
              <Clock class="mt-0.5 h-4 w-4 shrink-0 text-brass-500" aria-hidden="true" />
              <span class="flex flex-col">
                {SITE.hours.map((line) => <span>{line.days}: {line.time}</span>)}
              </span>
            </li>
          </ul>
          <a
            href={SITE.clientPortalUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-6 inline-flex items-center gap-2 border border-navy-900/20 px-4 py-2.5 text-sm font-medium text-navy-900 transition-colors hover:border-navy-900 hover:bg-navy-900/5"
          >
            <LogIn class="h-4 w-4" aria-hidden="true" />
            Client Login
            <span class="sr-only">(opens in a new tab)</span>
          </a>
        </div>
      </div>
    </div>
  </Section>

  <Section tone="creamAlt" padding="tight">
    <div data-reveal>
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brass-600">Find Us</p>
      <h2 class="mt-3 font-serif text-2xl tracking-tight text-navy-950">
        {SITE.addressLine1}, {SITE.addressCity}, {SITE.addressState} {SITE.addressZip}
      </h2>
    </div>
    <div class="mt-8 aspect-[16/9] w-full overflow-hidden border border-navy-900/10" data-reveal data-reveal-delay="1">
      <iframe
        src={mapSrc}
        title={`Map showing ${SITE.name}'s location in ${SITE.addressCity}, ${SITE.addressState}`}
        class="h-full w-full"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      />
    </div>
  </Section>
</Layout>
