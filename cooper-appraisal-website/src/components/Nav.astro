---
import { Menu, X, Phone } from '@lucide/astro';
import Button from './Button.astro';
import { SITE, NAV_LINKS } from '../data/site';

const { pathname } = Astro.url;
---

<header id="site-nav" class="fixed inset-x-0 top-0 z-50 text-cream-50" data-nav>
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 md:px-8">
    <a href="/" class="font-serif text-lg tracking-wide">
      Cooper <span class="text-brass-400">Appraisal</span>
    </a>

    <nav class="hidden items-center gap-8 lg:flex" aria-label="Primary">
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class:list={[
              'text-sm font-medium tracking-wide transition-colors hover:text-brass-400',
              pathname === link.href && 'text-brass-400',
            ]}
            aria-current={pathname === link.href ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-6 lg:flex">
      <a href={SITE.phoneHref} class="flex items-center gap-2 text-sm font-medium transition-colors hover:text-brass-400">
        <Phone class="h-4 w-4" aria-hidden="true" />
        {SITE.phone}
      </a>
      <Button href="/contact" variant="accent" size="md">Request an Appraisal</Button>
    </div>

    <button
      type="button"
      id="mobile-menu-toggle"
      class="inline-flex items-center justify-center p-2 lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
    >
      <Menu class="h-6 w-6" data-icon-open aria-hidden="true" />
      <X class="hidden h-6 w-6" data-icon-close aria-hidden="true" />
    </button>
  </div>

  <div
    id="mobile-menu"
    class="hidden border-t border-cream-50/10 bg-navy-950 lg:hidden"
    role="dialog"
    aria-modal="true"
    aria-label="Mobile navigation"
  >
    <nav class="flex flex-col gap-1 px-6 py-6" aria-label="Mobile">
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class="border-b border-cream-50/10 py-3 text-base font-medium text-cream-50 last:border-none hover:text-brass-400"
            aria-current={pathname === link.href ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <a href={SITE.phoneHref} class="mt-4 flex items-center gap-2 text-sm font-medium text-cream-50">
        <Phone class="h-4 w-4" aria-hidden="true" />
        {SITE.phone}
      </a>
      <Button href="/contact" variant="accent" size="md" class="mt-4 w-full">Request an Appraisal</Button>
    </nav>
  </div>
</header>

<style>
  #site-nav {
    background: transparent;
    padding-block: 1.5rem;
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.35s ease,
      padding 0.35s ease,
      box-shadow 0.35s ease,
      border-color 0.35s ease,
      color 0.35s ease;
  }
  #site-nav.is-scrolled {
    background: color-mix(in srgb, var(--color-cream-50) 94%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    padding-block: 0.85rem;
    border-bottom-color: color-mix(in srgb, var(--color-navy-900) 8%, transparent);
    box-shadow: 0 12px 30px -18px rgba(16, 28, 48, 0.35);
    color: var(--color-navy-950);
  }
  #site-nav.is-scrolled a:hover {
    color: var(--color-brass-500);
  }
</style>

<script>
  const header = document.getElementById('site-nav');
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = toggle?.querySelector('[data-icon-open]');
  const iconClose = toggle?.querySelector('[data-icon-close]');

  function updateScrollState() {
    header?.classList.toggle('is-scrolled', window.scrollY > 40);
  }
  updateScrollState();
  window.addEventListener('scroll', updateScrollState, { passive: true });

  function openMenu() {
    menu?.classList.remove('hidden');
    toggle?.setAttribute('aria-expanded', 'true');
    iconOpen?.classList.add('hidden');
    iconClose?.classList.remove('hidden');
    document.body.classList.add('overflow-hidden');
  }
  function closeMenu() {
    menu?.classList.add('hidden');
    toggle?.setAttribute('aria-expanded', 'false');
    iconOpen?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
    document.body.classList.remove('overflow-hidden');
  }

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    if (expanded) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeMenu));

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      closeMenu();
      toggle.focus();
    }
  });
</script>
