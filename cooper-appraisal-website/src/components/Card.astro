---
interface Props {
  title?: string;
  class?: string;
}

const { title, class: className = '', ...rest } = Astro.props;
---

<div
  class:list={[
    'group relative flex h-full flex-col border border-navy-900/10 bg-white p-8 transition-all duration-300 hover:-translate-y-1 hover:border-brass-400/60 hover:shadow-soft',
    className,
  ]}
  {...rest}
>
  <slot name="icon" />
  {title && <h3 class="mt-5 font-serif text-xl text-navy-950">{title}</h3>}
  <div class="mt-3 flex-1 leading-relaxed text-navy-700/90">
    <slot />
  </div>
  <slot name="footer" />
</div>
