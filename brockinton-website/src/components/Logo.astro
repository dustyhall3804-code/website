---
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---
<span class:list={['logo', { compact }]}>
  <svg class="mark" viewBox="0 0 48 48" aria-hidden="true">
    <rect width="48" height="48" rx="6" fill="#f4b81f" />
    <!-- bucket teeth along the bottom edge -->
    <path d="M6 40h36v2.5l-4 3.5-4-3.5-4 3.5-4-3.5-4 3.5-4-3.5-4 3.5-4-3.5z" fill="#120e0b" opacity=".9" />
    <path d="M14 9h12.5c6 0 9.5 3 9.5 7.6 0 3.2-1.8 5.4-4.6 6.3 3.5.8 5.6 3.3 5.6 6.9 0 5-3.8 8.2-10.2 8.2H14zm7 5.6v6.2h4.3c2.2 0 3.5-1.2 3.5-3.1s-1.3-3.1-3.5-3.1zm0 11.4v6.6h4.8c2.4 0 3.8-1.2 3.8-3.3s-1.4-3.3-3.8-3.3z" fill="#120e0b" />
  </svg>
  {!compact && (
    <span class="words">
      <span class="name">Brockinton</span>
      <span class="sub">Land Management</span>
    </span>
  )}
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 0.7rem; color: var(--bone-50); }
  .mark { width: 42px; height: 42px; flex: none; }
  .words { display: grid; line-height: 1; }
  .name { font-family: var(--font-display); font-weight: 800; font-size: 1.55rem; letter-spacing: 0.04em; text-transform: uppercase; }
  .sub { font-family: var(--font-display); font-weight: 600; font-size: 0.78rem; letter-spacing: 0.3em; text-transform: uppercase; color: var(--yellow-400); margin-top: 3px; }
</style>
